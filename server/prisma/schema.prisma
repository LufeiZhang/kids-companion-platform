generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  teacher
  admin
}

enum RoomStatus {
  scheduled
  active
  ended
}

enum CoursewareType {
  image
  pdf
}

enum LearningTaskStatus {
  pending
  completed
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  phone          String?           @unique
  passwordHash   String
  role           UserRole
  avatar         String?
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  taughtRooms    ClassRoom[]       @relation("TeacherRooms")
  roomMemberships ClassRoomStudent[]
  courseware     Courseware[]
  whiteboardEvents WhiteboardEvent[]
  sentSignals    SignalLog[]       @relation("SignalSender")
  receivedSignals SignalLog[]      @relation("SignalTarget")
  rewardsGiven   RewardLog[]       @relation("RewardTeacher")
  rewardsReceived RewardLog[]      @relation("RewardStudent")
  reportsAsTeacher ClassSessionReport[] @relation("ReportTeacher")
  reportsAsStudent ClassSessionReport[] @relation("ReportStudent")
  auditLogs      AdminAuditLog[]   @relation("AdminActor")
  managedGroups  StudentGroup[]    @relation("GroupTeacher")
  tasksAssigned  LearningTask[]    @relation("TaskTeacher")
  tasksReceived  LearningTask[]    @relation("TaskStudent")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model StudentProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age           Int?
  grade         String?
  parentName    String?
  parentContact String?
  groupId       String?
  group         StudentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupMemberships StudentGroupMember[]
}

model TeacherProfile {
  id       String   @id @default(cuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio      String?
  subjects String[]
}

model StudentGroup {
  id          String           @id @default(cuid())
  name        String
  teacherId   String
  teacher     User             @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  description String?
  students    StudentProfile[]
  members     StudentGroupMember[]
  createdAt   DateTime         @default(now())
}

model StudentGroupMember {
  id               String         @id @default(cuid())
  groupId          String
  studentProfileId String
  group            StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([groupId, studentProfileId])
  @@index([studentProfileId])
}

model ClassRoom {
  id          String             @id @default(cuid())
  title       String
  teacherId   String
  teacher     User               @relation("TeacherRooms", fields: [teacherId], references: [id])
  students    ClassRoomStudent[]
  status      RoomStatus         @default(scheduled)
  startedAt   DateTime?
  endedAt     DateTime?
  coursewareId String?
  currentPage Int                @default(1)
  pomodoroStatus String?
  pomodoroDurationSeconds Int?
  pomodoroStartedAt DateTime?
  pomodoroEndsAt DateTime?
  pomodoroRemainingSeconds Int?
  pomodoroLabel String?
  whiteboardEvents WhiteboardEvent[]
  signals     SignalLog[]
  rewards     RewardLog[]
  sessionReports ClassSessionReport[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ClassRoomStudent {
  roomId    String
  studentId String
  room      ClassRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime?
  @@id([roomId, studentId])
}

model Courseware {
  id        String         @id @default(cuid())
  title     String
  type      CoursewareType
  fileUrl   String
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

model WhiteboardEvent {
  id        String    @id @default(cuid())
  roomId    String
  room      ClassRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  eventType String
  payload   Json
  createdAt DateTime  @default(now())
}

model SignalLog {
  id           String    @id @default(cuid())
  msgId        String    @unique
  roomId       String
  room         ClassRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User      @relation("SignalSender", fields: [fromUserId], references: [id])
  targetUserId String?
  targetUser   User?     @relation("SignalTarget", fields: [targetUserId], references: [id])
  msgType      String
  action       String
  payload      Json
  ackStatus    String
  createdAt    DateTime  @default(now())
}

model RewardLog {
  id         String    @id @default(cuid())
  roomId     String
  room       ClassRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User      @relation("RewardTeacher", fields: [teacherId], references: [id])
  studentId  String
  student    User      @relation("RewardStudent", fields: [studentId], references: [id])
  rewardType String
  message    String?
  createdAt  DateTime  @default(now())
}

model LearningTask {
  id          String             @id @default(cuid())
  title       String
  detail      String?
  status      LearningTaskStatus @default(pending)
  teacherId   String
  teacher     User               @relation("TaskTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String
  student     User               @relation("TaskStudent", fields: [studentId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([teacherId, createdAt])
  @@index([studentId, status])
}

model ClassSessionReport {
  id                 String    @id @default(cuid())
  roomId             String
  room               ClassRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            User      @relation("ReportTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId          String
  student            User      @relation("ReportStudent", fields: [studentId], references: [id], onDelete: Cascade)
  startedAt          DateTime?
  endedAt            DateTime?
  joinedAt           DateTime?
  durationMinutes    Int       @default(0)
  onTime             Boolean   @default(false)
  leftPage           Boolean   @default(false)
  leftPageCount      Int       @default(0)
  rewardCount        Int       @default(0)
  completedTaskCount Int       @default(0)
  handRaiseCount     Int       @default(0)
  feedbackCount      Int       @default(0)
  earlyFinishCount   Int       @default(0)
  idleCount          Int       @default(0)
  focusScore         Int       @default(0)
  teacherNotes       String?
  aiSummary          Json?
  parentSummary      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([roomId, studentId])
  @@index([teacherId, createdAt])
  @@index([studentId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AdminActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())
}
